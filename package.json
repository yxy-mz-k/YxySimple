{
  "name": "yxy-simple",
  "private": true,
  "version": "0.0.0",
  "description": "A Vue 3 plugin with TypeScript",
  "main": "dist/yxy-simple.umd.js",
  "module": "dist/yxy-simple.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/yxy-simple.es.js",
      "require": "./dist/yxy-simple.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "@vueuse/shared": "^14.2.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.2",
    "element-resize-detector": "^1.2.4",
    "mitt": "^3.0.1",
    "pinia": "^3.0.4",
    "sass": "^1.97.3",
    "vue": "^3.5.24",
    "vue-clipboard3": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.1.4"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.2.0",
    "@vueuse/shared": "^14.2.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.2",
    "element-resize-detector": "^1.2.4",
    "mitt": "^3.0.1",
    "pinia": "^3.0.4",
    "vue-clipboard3": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    },
    "ant-design-vue": {
      "optional": true
    }
  }
}
